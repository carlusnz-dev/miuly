{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run fmt)",
      "Bash(npm run contract:emit)",
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(npx prisma:*)",
      "Bash(npm run dev:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(psql:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./**/.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
