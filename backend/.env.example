# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret that signs the access tokens (HS256). At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-chars"

# Optional. Defaults: NODE_ENV=development, PORT=8080.
# NODE_ENV="development"
# PORT=8080
